    body.relative
        .overflow-x-hidden
            .toast-custom 
                .toast-custom-body Successfully added
            .toast-custom-bought
                .toast-custom-body-bought.d-flex.align-items-center
                    img(src="data:image/jpeg;base64,", alt="")
                    p
                        span 200-450 Skins | Full Access 
                        | was purchased now
            .burger-open
                .close-burger
                ul 
                    li 
                        a(href='index.html#products' data-section="products") Products
                    li 
                        a(href='index.html#reviews' data-section="reviews") Reviews
                    li 
                        a(href='index.html#faq' data-section="faq") FAQ
                    li 
