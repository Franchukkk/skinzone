doctype html
html(lang="en")
    head
        meta(charset="UTF-8")
        meta(name="viewport", content="width=device-width, initial-scale=1.0")
        title Document
    body 
        style(type="text/css").
            body {
                background-color: #000;
                font-family: arial;
                
            }

            * {
                color: #FFF;
                font-style: normal;
                margin: 0;
                padding: 0;
                text-transform: uppercase;
            }

            .title-xxl {
                font-size: 32px;
                font-weight: bolder;
                text-align: center;
                margin-bottom: 32px;
                padding-top: 5px
            }

            .title-l {
                font-size: 20px;
                font-weight: bolder;
                text-align: center;
                padding-bottom: 25px;
            }

            table {
                width: 100%;
            }

            .title-m {
                font-size: 15px;
                font-weight: bolder;
                text-align: center;
            }

            img {
                width: 100%;
                height: auto;
            }

            .gradient {
                padding: 15px;
                background: radial-gradient(53.16% 52.75% at 50% 50%, #EA8BFF 0%, rgba(234, 139, 255, 0.00) 100%);
            }

            .order-number {
                color: #DF60DF;
                font-size: 32px;
                font-weight: bolder;
                text-align: center;
            }
            
            .m-5{
                padding-bottom: 5px;
            }

            a {
                display: block;
                margin: 0 auto;
                max-width: 145px;
                color: #FFF;
                font-size: 18px;
                font-weight: 400;
                border-radius: 40px;
                background: #EA8BFF;
                font-weight: bolder;
                padding-top: 10px;
                padding-bottom: 10px;
                text-decoration: none;
                text-align: center;
            }

            .p-15 {
                padding-bottom: 15px
            }

            .footer {
                padding-top: 15px;
                padding-bottom: 15px;
                padding-left: 15px;
                padding-right: 15px;
                background: #292929;
            }

            .footer p {
                color: #FFF;
                font-size: 12px;
                text-align: center;
            }
