doctype html
html(lang="en")
    head
        meta(charset="UTF-8")
        meta(http-equiv="X-UA-Compatible", content="IE=edge")
        meta(name="viewport", content="width=device-width, initial-scale=1.0")
        title Document
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">

        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Anton+SC&display=swap" rel="stylesheet">
        link(rel="stylesheet", href="css/styles.css")

    body
        include components/mixins
        +basket()
        .snow-container
        .burger-open
            .close-burger
            ul 
                li 
                    a(href='index.html#products' data-section="products") Products
                li 
                    a(href='index.html#reviews' data-section="reviews") Reviews
                li 
                    a(href='index.html#faq' data-section="faq") FAQ
                li 
                    a(href='index.html#help' data-section="help") HELP CEnter    
            
        header
            .wrapper
                +header-line()
        main
            .wrapper
                .checkout-blocks.row
                    form(action="").checkout-form.col-12.col-md-12.col-lg-6.help
                        .form-part
                            .row 
                                .col-sm-12.col-md-6
                                    p 
                                        label(for="name") Name
                                    input(id="name" type="text" placeholder="write...") 
                                .col-sm-12.col-md-6
                                    p 
                                        label(for="surname") Last name
                                    input(id="surname" type="text" placeholder="write...") 
                            p 
                                label(for="email") Email
                            input(id="email" type="email" placeholder="write...") 
                            p 
                                label(for="phone") Phone
                            input(id="phone" type="tel" placeholder="write...") 
                            p 
                                label(for="promo") Promocode
                            input(id="promo" type="text" placeholder="write...") 
                            .addons-container
                                h3 
                                    label.addons-title Addons
                                .addons-list 
                                    .d-flex.align-items-center.addon-item
                                        input(type="checkbox" id="chance" name="chance")
                                        label(for="chance").w-80 🔥 Increase the chance of rare outfits 
                                            span (+15$) (optional)
                                    .d-flex.align-items-center.addon-item
                                        input(type="checkbox" id="delivery" name="delivery")
                                        label(for="delivery").w-80 🚀 Super fast delivery 
                                            span (+20$) (optional)
                                    .d-flex.align-items-center.addon-item
                                        input(type="checkbox" id="glidersChance" name="glidersChance")
                                        label(for="glidersChance").w-80 🪂 Increase the chance of rare gliders 
                                            span (+10$) (optional)
                                    .d-flex.align-items-center.addon-item
                                        input(type="checkbox" id="pickaxes" name="pickaxes")
                                        label(for="pickaxes").w-80 🪓 Increase the chance of rare pickaxes 
                                            span (+10$) (optional)
                                    .d-flex.addon-item
                                        input(type="checkbox" id="emotes" name="emotes")
                                        label(for="emotes").w-80 💃 Increase the chance of exclusive emotes 
                                            span (+10$) (optional)
                    .help.col-12.col-md-12.col-lg-6
                        .form-part.checkout-products
                            .d-flex.justify-content-between.products-table-head 
                                label Your order 
                                label Subtotal
                            .checkout-products-scroll-list
                                //- .d-flex.justify-content-between 
                                //-     span Product name
                                //-     span.checkout-product-price 999$
                                //- .d-flex.justify-content-between 
                                //-     span Product name
                                //-     span.checkout-product-price 999$
                                //- .d-flex.justify-content-between 
                                //-     span Product name
                                //-     span.checkout-product-price 999$
                                //- .d-flex.justify-content-between 
                                //-     span Product name
                                //-     span.checkout-product-price 999$
                                //- .d-flex.justify-content-between 
                                //-     span Product name
                                //-     span.checkout-product-price 999$
                                //- .d-flex.justify-content-between 
                                //-     span Product name
                                //-     span.checkout-product-price 999$
                                //- .d-flex.justify-content-between 
                                //-     span Product name
                                //-     span.checkout-product-price 999$
                                //- .d-flex.justify-content-between 
                                //-     span Product name
                                //-     span.checkout-product-price 999$
                            br
                            .d-flex.justify-content-between 
                                p Addons:
                            .checkout-products-scroll-list.checkout-products-scroll-addons
                                //- .d-flex.justify-content-between
                                //-     span 🔥 Increase the chance of rare outfits
                                //-     span.checkout-product-price 15$
                                //- .d-flex.justify-content-between 
                                //-     span 🔥 Increase the chance of rare outfits
                                //-     span.checkout-product-price 15$
                                //- .d-flex.justify-content-between 
                                //-     span 🔥 Increase the chance of rare outfits
                                //-     span.checkout-product-price 15$
                                //- .d-flex.justify-content-between 
                                //-     span 🔥 Increase the chance of rare outfits
                                //-     span.checkout-product-price 15$
                                //- .d-flex.justify-content-between 
                                //-     span 🔥 Increase the chance of rare outfits
                                //-     span.checkout-product-price 15$
                            br
                            .d-flex.justify-content-between 
                                label Total
                                label.total-checkout-price $0
                        .checkout-products.addons-list.check-out-payment-method.d-flex
                            div.w-100
                                .row.wrap.mb-3
                                    //- label.d-flex.justify-content-center.align-items-center.col-sm-6.col-md-6.col-lg-6
                                    //-     input(type="radio" name="paymentMethod" id="paypal" data-value="paypal" onchange="checkPaymentMethod()").payment-method-btn
                                    //-     img(src="img/paypal.png", alt="")
                                    label.d-flex.justify-content-center.align-items-center.col-sm-6.col-md-6.col-lg-6
                                        input(type="radio" name="paymentMethod" id="visamastercard" data-value="visamastercard" onchange="checkPaymentMethod()").payment-method-btn
                                        img(src="img/visamastercard.png", alt="")
                                    label.d-flex.justify-content-center.align-items-center.col-sm-6.col-md-6.col-lg-6
                                        input(type="radio" name="paymentMethod" id="coinpayments" data-value="coinpayments" onchange="checkPaymentMethod()").payment-method-btn
                                        img(src="img/black-coin-payments.png", alt="")

                                .row 
                                    .col-12.d-none.coinpayments-currency
                                        select(name="currency" id="currency" class="currency") 
                                            option(value="BTC") Bitcoin
                                            option(value="BNB") BNB Coin
                                            option(value="Ether") Ether
                                            option(value="Solana") Solana
                                            option(value="TRON") TRON
                                            option(value="USDT.BEP20") USDT.BEP20
                                            option(value="USDT.ERC20") USDT.ERC20
                                            option(value="USDT.PRC20") USDT.PRC20
                                            option(value="USDT.SOL") USDT.SOL
                                            option(value="USDT.TRC20") USDT.TRC20
                        .d-flex.justify-content-center
                            a(href="#").button.submit-order Submit order

        <script src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.11.8/dist/umd/popper.min.js" integrity="sha384-I7E8VVD/ismYTF4hNIPjVp/Zjvgyol6VFvRkX/vR+Vc4jQkC+hVqc2pM8ODewa9r" crossorigin="anonymous"></script>
